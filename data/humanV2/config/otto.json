{
    "start_frame": 1,
    "end_frame": 200,
    "geo_dir": "data/humanV2/model",
    "target_mode": "mesh",
    "use_sliding": false,
    "slide_range": 0.005,
    "slide_interval": 999999,

    "rest_path": "data/humanV2/model/otto.usd",
    "muscle_prim_root": "/char/muscle",
    "usd_local_space": true,

    "bone_usd": "data/humanV2/model/otto.usd",
    "bone_root": "/char/bone",

    "use_fascia": false,
    "fascia_path": "data/humanV2/model/otto.usd",
    "fascia_prim_root": "/char/tissue",
    "fascia_mode": "squeeze",
    "fascia_bind_max_dist": 0.05,

    "quasi_static": false,
    "use_multigrid": false,
    "omega": 0.1,
    "delta_t": 0.04166,
    "gravity": [0.0, 0.0, 0.0],
    "total_mass": 70.0,
    "mass_density": -1.0,
    "fine_iterations": 20,
    "nsubsteps": 10,

    "constraints": [
        { "type": "tetarapsvd", "name": "arap",           "enable": true,  "stiffness": 1e5,       "dampingratio": 0.1 },
        { "type": "fiber",      "name": "fiber",          "enable": true,  "stiffness": 1e6,       "dampingratio": 0.1, "fiber_model": "fibernorm", "contraction_ratio": 0.4 },
        { "type": "attach",     "name": "belly_attach",   "enable": true,  "stiffness": 1e6,       "dampingratio": 0.1 },
        { "type": "pin",        "name": "muscleToBonePin","enable": true,  "region": "pinmask",    "pin_threshold": 0.5 },
        { "type": "glue",       "name": "muscleToMuscleGlue", "enable": true, "stiffness_scale": 1.0, "distance": -1.0, "knn": 8, "mask_threshold": 0.5 },
        { "type": "glue",       "name": "fascia_glue",    "enable": true,  "stiffness_scale": 0.25,"dampingratio": 0.1, "iterations": 20},
        { "type": "tetarapsvd", "name": "fascia_arap",    "enable": true,  "stiffness": 1000.0,    "dampingratio": 0.1, "rest_scale": 0.95 },
        { "type": "volume",     "name": "fascia_volume",  "enable": true,  "stiffness": 1e6,       "dampingratio": 0.1 },
        { "type": "anchor",     "name": "fascia_anchor",  "enable": true,  "count": 4000 },
        { "type": "snh",        "name": "fascia_snh",     "enable": true,  "mu": 1e3,              "lam": 1e8, "dampingratio": 0.1 }
    ],

    "demo": {
        "out": "output/otto/otto_m2m.usd",
        "graft_src": "data/humanV2/model/otto.usd",
        "sim_scope": "/char/sim",
        "device": "cuda:0",
        "no_export": false,
        "geo_out": null,
        "no_collide_primvars": true,
        "activate": null,
        "collision": {
            "enabled": true,
            "static_bone": false,
            "max_dist": 0.2,
            "contact_offset": 1e-5,
            "collide_eps": 1e-6,
            "max_push": -1.0,
            "flip_bone_winding": true
        },
        "self_collision": {
            "method": "none"
        }
    }
}
