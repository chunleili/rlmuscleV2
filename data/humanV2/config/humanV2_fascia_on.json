            "iterations": 20
        },
        {
            "type": "tetarapsvd",
            "name": "fascia_arap",
            "enable": true,
            "stiffness": -1.0,
            "dampingratio": 0.1,
            "rest_scale": 0.9
        },
        {
            "type": "volume",
            "name": "fascia_volume",
            "enable": true,
            "stiffness": 1000000.0,
            "dampingratio": 0.1
        },
        {
            "type": "snh",
            "name": "fascia_snh",
            "enable": true,
            "mu": 1000.0,
            "lam": 100000000.0,
            "dampingratio": 0.1
        }
    ],
    "demo": {
        "out": "output/humanV2/fascia_on.usd",
