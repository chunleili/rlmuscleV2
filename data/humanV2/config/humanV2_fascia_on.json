    "nsubsteps": 10,
    "constraints": [
        {
            "type": "tetarapsvd",
            "name": "arap",
            "enable": true,
            "stiffness": 1000000.0,
            "dampingratio": 0.1
        },
        {
            "type": "attach",
            "name": "belly_attach",
            "enable": true,
            "stiffness": 1000000.0,
            "dampingratio": 0.1
        },
        {
            "type": "pin",
            "name": "muscleToBonePin",
            "enable": true,
            "region": "pinmask",
            "tendon_pin_threshold": 1.1
        },
        {
            "type": "glue",
            "name": "fascia_glue",
            "enable": true,
            "stiffness_scale": 0.5,
