{
    "start_frame": 1,
    "end_frame": 200,
    "geo_dir": "data/humanV2/model",
    "cons_dir": "data/humanV2/model/cons",
    "rest_path": "data/humanV2/model/muscle/restpos.geo",

    "use_fascia": false,
    "fascia_path": "data/humanV2/model/fascia/fascia.geo",

    "quasi_static": true,
    "use_multigrid": true,
    "coarse_npz_path": "data/humanV2/model/muscle/coarse_cage.npz",
    "omega": 0.1,
    "delta_t": 0.04166,
    "gravity": [0.0, 0.0, 0.0],
    "total_mass": 70.0,
    "mass_density": -1.0,
    "fine_iterations": 2,
    "nsubsteps": 10,

    "constraints": [
        { "type": "tetarapsvd", "name": "arap",          "stiffness": 1e9,       "dampingratio": 0.1 },
        { "type": "attach",     "name": "belly_attach",  "stiffness": 1e6,       "dampingratio": 0.1, "tendon_pin_threshold": 0.0 },
        { "type": "glue",       "name": "fascia_glue",   "stiffness_scale": 0.5, "dampingratio": 0.1, "iterations": 2 },
        { "type": "tetarapsvd", "name": "fascia_arap",   "stiffness": -1.0,      "dampingratio": 0.1, "rest_scale": 0.9 },
        { "type": "volume",     "name": "fascia_volume", "stiffness": 1e10,      "dampingratio": 0.1 }
    ],

    "demo": {
        "out": "output/humanV2/humanV2.usd",
        "bone_dir": "data/humanV2/model/bone",
        "device": "cuda:0",
        "no_export": false,
        "geo_out": null,
        "no_collide_primvars": true,
        "activate": null,
        "collision": {
            "enabled": true,
            "static_bone": false,
            "max_dist": 0.2,
            "contact_offset": 1e-5,
            "collide_eps": 1e-6,
            "max_push": -1.0
        },
        "self_collision": {
            "method": "none"
        }
    }
}
