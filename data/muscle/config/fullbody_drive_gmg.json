      "stiffness": 10000000000.0,
      "dampingratio": 0.1
    },
    {
      "type": "fiber",
      "name": "tetfibernorm",
      "stiffness": 10000000000.0,
      "dampingratio": 0.1
    },
    {
      "type": "attach",
      "name": "muscleToBonesAttach",
      "mask_name": "muscletobonemask",
      "mask_threshold": 0.75,
      "stiffness": 10000000000.0,
      "dampingratio": 0.1
    },
    {
      "type": "pintotarget",
      "name": "muscleEndPin",
      "mask_name": "muscleendmask",
