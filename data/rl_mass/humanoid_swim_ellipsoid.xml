<mujoco model="mass_humanoid_swim_ellipsoid">
    <compiler angle="radian" eulerseq="XYZ" />
    <!-- Swim task v2: micro-gravity + ellipsoid fluidshape.
         Inertia-box fluid model was too weak on body long axis (cross-section
         r derived from diagonal inertia is tiny -> r^4 angular drag negligible).
         Per-geom ellipsoid fluidshape uses actual geom extents and adds a
         buoyancy *moment* via center-of-buoyancy vs center-of-mass offset —
         passive righting torque kills the top-like spin.
         Micro-gravity (-0.5 m/s^2) supplies an absolute "up" so the CoB-CoG
         moment has a direction to align with. Viscosity back to ~water (1e-3);
         the ellipsoid model provides the strong drag now. -->
    <option gravity="0 0 -0.5" density="1000" viscosity="0.001" integrator="Euler" solver="Newton" timestep="0.00166667" />
    <default>
        <joint damping="0.4" />
        <geom condim="3" friction="0.8 0.005 0.0001" rgba="0.6 0.6 0.8 1" fluidshape="ellipsoid" />
    </default>
